# Generate each secret once and keep it. Changing ENCRYPTION_KEY, BETTER_AUTH_SECRET or
# SPARKY_API_ENCRYPTION_KEY later breaks stored keys and sign-ins.
# Passwords: openssl rand -hex 24
POSTGRES_PASSWORD=
GAUNTLET_DB_PASSWORD=
SPARKY_DB_PASSWORD=
SPARKY_APP_DB_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32
ENCRYPTION_KEY=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -hex 32
SPARKY_API_ENCRYPTION_KEY=

# Public addresses (what browsers and phones use)
PUBLIC_WEB_URL=http://localhost:8080
SPARKY_PUBLIC_URL=http://localhost:3004
TZ=America/New_York
# Optional: this email becomes the SparkyFitness admin (otherwise the first account to sign up)
SPARKY_ADMIN_EMAIL=
# Gauntlet admins (comma separated) can feature public challenges in Discover.
ADMIN_EMAILS=
# Other addresses the SparkyFitness site is reached at (comma separated), e.g. https://fit.example.com
SPARKY_EXTRA_ORIGINS=
# Android app: downloads and in-app updates come from the latest GitHub release of this repository
# (owner/name). A private repository also needs a fine-grained token with read-only "Contents" access.
GITHUB_RELEASES_REPO=
GITHUB_TOKEN=
# Browser notifications (Web Push) need a key pair that belongs to this server. Create it once with
#   npx web-push generate-vapid-keys
# and keep it: changing it signs every browser out of push. VAPID_SUBJECT is a contact address such as
# mailto:you@example.com. Leave all three empty to run without browser notifications (the in-app list
# and the Android app's notifications work either way).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Release signing key SHA-256 fingerprint(s) (AB:CD:...), so invite links open the Android app.
ASSETLINKS_SHA256=
