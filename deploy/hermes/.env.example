# Copy to /opt/gauntlet/.env on hermes-pc and fill in. Never commit the real file.

# openssl rand -base64 24
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   Encrypts stored SparkyFitness API keys. Keep it stable and backed up:
# changing it makes every stored key unreadable and everyone has to sign in again.
ENCRYPTION_KEY=

# The public address Cloudflare serves (used in invite links, cookies and CORS).
PUBLIC_WEB_URL=https://gauntlet.example.com
SPARKY_URL=https://fit.randalls.cc

# Optional
GAUNTLET_PORT=3333
# Set to 127.0.0.1 if cloudflared runs on this machine and you don't want the port open on your LAN.
GAUNTLET_BIND=0.0.0.0
# Release key SHA-256 (printed by scripts/make-keystore.sh) so invite links open the Android app.
ASSETLINKS_SHA256=
