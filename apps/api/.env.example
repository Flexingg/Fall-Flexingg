# Postgres for Gauntlet's own data (users, friends, challenges)
DATABASE_URL=postgres://gauntlet:change-me@localhost:5432/gauntlet
# Your SparkyFitness server
SPARKY_URL=https://fit.randalls.cc
# Public URL the app is served from (used in invite links and CORS)
PUBLIC_WEB_URL=https://gauntlet.randalls.cc
# Extra origins allowed to call the API, comma separated (Capacitor uses https://localhost)
EXTRA_ORIGINS=https://localhost,capacitor://localhost
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32  (encrypts stored SparkyFitness API keys)
ENCRYPTION_KEY=
PORT=8080
SYNC_INTERVAL_MINUTES=15
